# Supabase — optional. Without these, the app runs in guest mode with no
# accounts or sync, exactly as before. Get both from your Supabase project's
# API settings. The publishable key is safe to expose in the browser (row-level
# security protects the data); set real values in .env.local (gitignored) and in
# your host's environment variables, never in the repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server-side only (the functions in api/). Never VITE_-prefixed, so they
# never reach the browser bundle. All optional.
#
# Shared free AI tier: without a key, visitors get engine picks only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# AI_FREE_DAILY_PER_IP=20
# AI_FREE_DAILY_GLOBAL=900
# Durable quota + reason cache (supabase/migrations/*_ai.sql). Without these the
# functions keep both in memory, which only suits local dev.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Salt for hashing visitor IPs before they're stored. Any long random string.
IP_HASH_SALT=
